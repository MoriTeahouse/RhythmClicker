<Window x:Class="RhythmClicker.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RhythmClicker · 專屬啟動器" Width="1180" Height="920" MinWidth="1080" MinHeight="890" Icon="Assets/game-icon.png" WindowStartupLocation="CenterScreen" Background="#0E1B24" Foreground="#EEE7D9" FontFamily="Segoe UI, Microsoft JhengHei" FontSize="14">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="46" /></Grid.RowDefinitions>
    <Grid><StackPanel Orientation="Horizontal"><Image Source="Assets/game-icon.png" Width="54" Height="54" Margin="0,0,16,0" /><StackPanel VerticalAlignment="Center"><TextBlock Text="RHYTHMCLICKER" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="森之宿茶室 · 專屬啟動器" Foreground="#98DFBC" Margin="0,4,0,0" /></StackPanel></StackPanel><Button Content="GitHub 發布頁 ↗" Click="Releases_Click" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
    <Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="0.94*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="1.06*" /></Grid.ColumnDefinitions>
      <Border CornerRadius="18" Padding="30"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C3A40" /><GradientStop Color="#101F2C" Offset="1" /></LinearGradientBrush></Border.Background>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><Border Background="#294E46" CornerRadius="7" Padding="12,7" HorizontalAlignment="Left"><TextBlock Text="大更新測試版本 · 第二版" Foreground="#CBECCE" FontSize="12" /></Border><TextBlock Text="每一次敲擊，&#10;都是新的回聲。" FontSize="36" FontWeight="SemiBold" LineHeight="49" Margin="0,24,0,0" /><TextBlock Text="四軌節奏 × 原創茶室樂章" Foreground="#AAC3C6" Margin="0,16,0,0" /></StackPanel>
          <Grid Grid.Row="1" Margin="0,22,0,18"><UniformGrid Columns="4" Margin="18,0"><Border Background="#193E37" Margin="4,0" CornerRadius="14" /><Border Background="#1D3449" Margin="4,0" CornerRadius="14" /><Border Background="#342B45" Margin="4,0" CornerRadius="14" /><Border Background="#3B352E" Margin="4,0" CornerRadius="14" /></UniformGrid><UniformGrid Columns="4" Margin="27,0" VerticalAlignment="Center"><Border Background="#83D6B2" Height="10" CornerRadius="5" Margin="0,65,8,0" /><Border Background="#83B5E4" Height="10" CornerRadius="5" Margin="0,0,8,65" /><Border Background="#C79DDD" Height="10" CornerRadius="5" Margin="0,95,8,0" /><Border Background="#E4B36C" Height="10" CornerRadius="5" Margin="0,0,0,95" /></UniformGrid><Image Source="Assets/game-icon.png" Width="115" Height="115" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Text="D     F     J     K" Foreground="#D5E8E5" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" /></Grid>
          <StackPanel Grid.Row="2"><TextBlock Text="FIND YOUR TEMPO" FontSize="17" FontWeight="SemiBold" Foreground="#98DFBC" /><TextBlock Text="下載、更新與執行環境一次就緒。&#10;安裝到哪一顆硬碟，玩家資料就留在哪裡。" Foreground="#AAC3C6" LineHeight="24" Margin="0,12,0,0" TextWrapping="Wrap" /><TextBlock Text="MoriTeahouse（森之宿茶室）&#10;原創程式 · AGPL-3.0-only" Foreground="#759A9F" FontSize="11" Margin="0,24,0,0" /></StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="#172B35" CornerRadius="18" Padding="26"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="安裝與遊玩" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="InstalledLabel" Text="尚未安裝" Foreground="#98DFBC" Margin="0,10,0,16" /><TextBlock Text="安裝資料夾（遊戲 / 暫存 / 玩家資料）" Foreground="#AAC3C6" FontSize="12" /><DockPanel><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="選擇" Click="Browse_Click" /><TextBox x:Name="RootInput" Margin="0,4,6,5" TextChanged="Root_Changed" /></DockPanel><CheckBox x:Name="IncludeTesting" Content="包含大更新測試版本" IsChecked="True" Foreground="#EEE7D9" Margin="0,8,0,16" Checked="Channel_Changed" Unchecked="Channel_Changed" /></StackPanel>
        <Border Grid.Row="1" Background="#11242D" CornerRadius="10" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock Text="可下載版本" Foreground="#759A9F" FontSize="12" /><TextBlock x:Name="AvailableLabel" Text="按「檢查更新」取得公開發布版本" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,9" TextWrapping="Wrap" /><TextBlock x:Name="ReleaseNotes" Foreground="#B5CBCA" FontSize="12" TextWrapping="Wrap" LineHeight="20" /></StackPanel></Border>
        <StackPanel Grid.Row="2"><TextBlock x:Name="PhaseLabel" Text="就緒" Foreground="#98DFBC" TextWrapping="Wrap" /><ProgressBar x:Name="Progress" Height="7" Margin="0,12,0,6" Maximum="100" Foreground="#83D6B2" Background="#0B1F28" BorderThickness="0" /><TextBlock x:Name="SizeLabel" Foreground="#759A9F" FontSize="11" /></StackPanel>
        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,12,0,12"><UniformGrid Columns="2"><Button x:Name="CheckButton" Content="檢查更新" Click="Check_Click" /><Button x:Name="LocalButton" Content="安裝本機 ZIP / ATR" Click="Local_Click" /></UniformGrid><Button x:Name="InstallButton" Content="下載並安裝" Click="Install_Click" Background="#365E50" FontSize="17" Padding="14,14" IsEnabled="False" /><Button x:Name="PlayButton" Content="▶ 開始遊戲" Click="Play_Click" Background="#426456" FontSize="19" Padding="14,14" IsEnabled="False" /><Button x:Name="CancelButton" Content="取消目前工作" Click="Cancel_Click" Visibility="Collapsed" /></StackPanel>
        <StackPanel Grid.Row="4"><Button x:Name="DataButton" Content="開啟玩家資料夾" Click="Data_Click" /><TextBlock x:Name="DataLabel" Foreground="#759A9F" FontSize="11" TextWrapping="Wrap" Margin="4,8,0,0" /></StackPanel>
      </Grid></Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="Windows x64 · 自帶 .NET 8 / SDL2 / OpenAL · 啟動器 1.0 測試版 · 公開下載免登入" Foreground="#78979C" FontSize="11" VerticalAlignment="Center" />
  </Grid>
</Window>
