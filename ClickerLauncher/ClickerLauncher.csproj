<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ClickerLauncher</AssemblyName>
    <RootNamespace>ClickerLauncher</RootNamespace>
    <ApplicationIcon>launcher.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Launcher icon (optional — place launcher.ico next to the .csproj) -->
    <None Include="launcher.ico" Condition="Exists('launcher.ico')" />
  </ItemGroup>

</Project>
